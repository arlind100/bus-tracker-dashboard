# ─── Firebase Web Config ──────────────────────────────────────────────────────
# These are PUBLIC client identifiers (safe to ship in a browser bundle). Access
# is controlled by Firestore Security Rules + Firebase Auth, not by secrecy.
# The dashboard connects to the SAME backend as the Bus Tracker mobile app:
# projectId / authDomain / storageBucket / messagingSenderId MUST stay identical.
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# NEVER put a service-account JSON here — the Admin SDK must never reach the browser.

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=bus-tracker-capstone.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bus-tracker-capstone
VITE_FIREBASE_STORAGE_BUCKET=bus-tracker-capstone.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=609888604919
VITE_FIREBASE_APP_ID=your-web-app-id
